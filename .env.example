# Measurement. Copy to .env and fill in the real values at deploy time.
# With all three blank the site loads no analytics script at all — no network
# request, no cookie, nothing to consent to.

# Google Analytics 4 measurement ID
VITE_GA4_ID=

# Google Tag Manager container ID (only if GTM is used instead of / alongside GA4)
VITE_GTM_ID=

# Google Search Console HTML-tag verification token (the content value only)
VITE_GSC_VERIFICATION=
